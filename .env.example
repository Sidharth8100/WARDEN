# .env.example
#
# WHAT IS THIS FILE?
# ==================
# This is a TEMPLATE for the real .env file. It lists every environment
# variable the project needs, with safe placeholder values.
#
# HOW TO USE:
#   cp .env.example .env
#   # Then edit .env and replace placeholder values with real ones.
#
# RULES:
#   - .env is in .gitignore and is NEVER committed (it has real passwords)
#   - .env.example IS committed - it shows what variables are needed
#   - Never put real secrets in this file


# ---- PostgreSQL (used by Docker Compose AND Alembic) ----
POSTGRES_USER=warden
POSTGRES_PASSWORD=changeme
POSTGRES_DB=warden

# ---- WARDEN API service settings ----
# Database URL for host-side alembic (when running migrations from your laptop).
# Port 5433 is published by docker-compose.override.yml (dev only).
# Format: postgresql+asyncpg://<user>:<password-url-encoded>@localhost:5433/<db>
# NOTE: if your password contains special chars (@ # % etc.), URL-encode them:
#   python3 -c "from urllib.parse import quote_plus; print(quote_plus('your_pass'))"
WARDEN_DATABASE_URL=postgresql+asyncpg://warden:changeme@localhost:5433/warden

# Redis URL for host-side tools (e.g. redis-cli from your laptop).
# Inside containers, the URL uses the service name: redis://redis:6379/0
WARDEN_REDIS_URL=redis://localhost:6379/0

# SeaweedFS S3-compatible API URL.
# Inside containers: http://objectstore:8333
# From your laptop (if you publish the port): http://localhost:8333
WARDEN_OBJECTSTORE_URL=http://objectstore:8333

# Log settings
WARDEN_LOG_LEVEL=INFO
WARDEN_JSON_LOGS=true

# ---- Prompt 2: Environment, Cookies & JWT Auth ----
WARDEN_ENV=dev
WARDEN_COOKIE_SECURE=false
WARDEN_JWT_PRIVATE_KEY_PATH=keys/jwt_ed25519_private.pem
WARDEN_JWT_PUBLIC_KEY_PATH=keys/jwt_ed25519_public.pem
WARDEN_JWT_KID=warden-key-1
WARDEN_ACCESS_TOKEN_TTL_SECONDS=900
WARDEN_REFRESH_TOKEN_TTL_SECONDS=2592000
